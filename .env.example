# Leave DATABASE_URL unset to use SQLite at ./data/app.db.
# Replit PostgreSQL URLs are supported without code changes.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

STORAGE_DIR=./data/certificates
MAX_RECIPIENTS=5000
WORKER_THREADS=4
WORKER_ENABLED=true
PUBLIC_BASE_URL=http://localhost:5000
# Optional: when set, require X-API-Key on batch and certificate management routes.
# Set the real value through your workspace's secret/environment-variable manager.
# API_KEY=replace-with-a-long-random-value
LOG_LEVEL=INFO
REQUEST_BODY_LIMIT_BYTES=2000000
